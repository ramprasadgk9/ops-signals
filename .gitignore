# Logs
*.log
logs/

# IDE and OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local UI reference images
web-ui-images/

# Local databases and runtime data
postgres_data/
qdrant_data/
*.db
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/
.cache/

# Benchmark reports are generated output (JSON/Markdown written by benchmark/router_benchmark.py
# on every run) - not source, and re-running the suite locally shouldn't dirty the working tree.
benchmark/reports/

# Benchmark evidence snapshots (benchmark/run_all.py) - one folder per run with results.json and
# report.html. Kept on the machine that produced them, never committed.
benchmark/results/

# Analyzer router experiment results, one JSON per routing run (experiments/analyzer_router/router.py).
experiments/analyzer_router/output/

# Local publication/paper drafts - not meant to be committed to the shared repo.
publication/

# Local marketing/positioning drafts - not meant to be committed to the shared repo.
market/

# Local tools and reports
.aider*
docs/smoke-test-report.html
