# AI for the demo from a model API you already have, instead of downloading a model (--profile ai).
#
#   cp demo/ai-api.env.example demo/ai-api.env
#   docker compose -f docker-compose.demo.yml --env-file demo/ai-api.env up
#
# demo/ai-api.env is gitignored; keep your key there rather than on the command line.
# Fill in ONE of the two blocks below.

# --- Any server that speaks the OpenAI chat completions API --------------------------------------
# A hosted API, a gateway, or a model server on your machine (use host.docker.internal instead of
# localhost).

# The API root, ending before /chat/completions, e.g. https://api.example.com/v1
DEMO_AI_URL=

# Leave empty if the server needs no key. Sent as "Authorization: Bearer <key>".
DEMO_AI_KEY=

# The model name the server expects.
DEMO_AI_MODEL=

# --- The Anthropic API ---------------------------------------------------------------------------
# Uncomment all four lines. The key comes from the provider's developer console; API usage is
# billed there, separately from any chat subscription.

# OPS_SIGNALS_AI_ENABLED=true
# OPS_SIGNALS_AI_PROVIDER=anthropic
# OPS_SIGNALS_ANTHROPIC_API_KEY=
# OPS_SIGNALS_ANTHROPIC_MODEL=claude-haiku-5-5

# --- Optional ------------------------------------------------------------------------------------
# The "Things to try" guide is on by default. To hide it:
# OPS_SIGNALS_DEMO_TOUR=false

# Full demo mode, as on a shared public demo: adds a sample-data banner and view-only settings. With
# it on, Integrations -> AI provider -> Test connection is refused; check AI with an AI button
# instead, e.g. Draft from case on a case's Resolution tab.
# OPS_SIGNALS_DEMO_MODE=true
