# Ops Signals - environment configuration template
# Copy this file to .env and fill in real values. .env is gitignored and loaded
# automatically by scripts/run_all.sh if present - no need to export these by hand.

# -----------------------------------------------------------------------------
# Database (PostgreSQL / TimescaleDB)
# -----------------------------------------------------------------------------
OPS_SIGNALS_DATABASE_URL=postgresql+psycopg://ops_signals:ops_signals@localhost:5432/ops_signals

# -----------------------------------------------------------------------------
# Security & Access Controls (docs/security-model.md)
# -----------------------------------------------------------------------------
# When OPS_SIGNALS_API_TOKEN is set, all API requests require Authorization: Bearer <token>
# Leave unset or empty for open local development on trusted networks.
# OPS_SIGNALS_API_TOKEN=your-random-32-byte-hex-token

# Sign-in for the web UI through your company's sign-in proxy (docs/web-ui-sign-in.md).
# Needs OPS_SIGNALS_API_TOKEN. The proxy names the user and their groups in headers; the groups
# decide the role (Admin, Editor, else Viewer). Group lists are comma-separated.
# OPS_SIGNALS_AUTH_MODE=proxy-headers
# OPS_SIGNALS_AUTH_USER_HEADER=X-Forwarded-Email
# OPS_SIGNALS_AUTH_GROUPS_HEADER=X-Forwarded-Groups
# OPS_SIGNALS_AUTH_EDITOR_GROUPS=sre,platform
# OPS_SIGNALS_AUTH_ADMIN_GROUPS=ops-signals-admins
# Or let Ops Signals sign people in itself with your company's identity provider (OpenID Connect).
# Needs OPS_SIGNALS_API_TOKEN. Register the redirect address <your web UI>/api/auth/callback with the
# provider; Setup check -> Login shows it and tests the settings.
# OPS_SIGNALS_AUTH_MODE=oidc
# OPS_SIGNALS_OIDC_ISSUER_URL=https://your-provider/...
# OPS_SIGNALS_OIDC_CLIENT_ID=
# OPS_SIGNALS_OIDC_CLIENT_SECRET=
# OPS_SIGNALS_AUTH_EDITOR_GROUPS=sre,platform
# OPS_SIGNALS_AUTH_ADMIN_GROUPS=ops-signals-admins
# Optional: only these groups may sign in; the claim that carries groups; the sign-in button's words;
# session length in hours; the address people use (when a proxy hides it).
# OPS_SIGNALS_OIDC_ALLOWED_GROUPS=
# OPS_SIGNALS_OIDC_GROUPS_CLAIM=groups
# OPS_SIGNALS_OIDC_PROVIDER_NAME="your company account"
# OPS_SIGNALS_SESSION_HOURS=8
# OPS_SIGNALS_PUBLIC_URL=https://ops-signals.example.com
# No provider yet? scripts/run_all.sh starts a local test provider with test accounts (Viewer, Editor,
# Admin) when this is true. For trying sign-in on this computer only; leave the OIDC lines above unset.
# OPS_SIGNALS_TEST_SIGN_IN=true
# Try sign-in on your own machine without a proxy: act as this user ("email:Role"). Only works
# without OPS_SIGNALS_API_TOKEN; never set it on a shared install.
# OPS_SIGNALS_DEV_USER=priya@example.com:Viewer

# Enable dangerous endpoints (disabled by default)
OPS_SIGNALS_ALLOW_FILE_WRITES=false
OPS_SIGNALS_ENABLE_TESTING_API=false

# Allowed browser origins for CORS (comma-separated)
OPS_SIGNALS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# -----------------------------------------------------------------------------
# Operational Memory & Vector Search (Qdrant)
# -----------------------------------------------------------------------------
OPS_SIGNALS_QDRANT_URL=http://localhost:6333
# OPS_SIGNALS_QDRANT_API_KEY=your-qdrant-api-key

# -----------------------------------------------------------------------------
# Prometheus Integration
# -----------------------------------------------------------------------------
OPS_SIGNALS_PROMETHEUS_URL=http://localhost:9090
# OPS_SIGNALS_PROMETHEUS_USERNAME=
# OPS_SIGNALS_PROMETHEUS_PASSWORD=
# OPS_SIGNALS_PROMETHEUS_BEARER_TOKEN=
OPS_SIGNALS_PROMETHEUS_TIMEOUT_SECONDS=30
# Several Mimir tenants or Prometheus servers: list them in a file instead (start from
# examples/prometheus-connections.yaml). It replaces the single connection above.
# OPS_SIGNALS_PROMETHEUS_CONNECTIONS_FILE=prometheus-connections.yaml
# scripts/run_all.sh starts a bundled Prometheus with mock metrics only while the URL above is
# localhost:9090 and no connections file is set. true or false overrides that.
# OPS_SIGNALS_LOCAL_PROMETHEUS=

# -----------------------------------------------------------------------------
# Optional AI Assistance (Ollama)
# -----------------------------------------------------------------------------
# Enable AI-assisted narrative generation and zero-click comment triage
OPS_SIGNALS_AI_ENABLED=false
OPS_SIGNALS_AI_PROVIDER=ollama
OPS_SIGNALS_OLLAMA_URL=http://localhost:11434
OPS_SIGNALS_OLLAMA_MODEL=llama3.2:latest

# -----------------------------------------------------------------------------
# Pluggable Ticketing Integration (Jira Cloud Reference Provider)
# -----------------------------------------------------------------------------
# Enable ticketing (API endpoints and the background outbox worker)
OPS_SIGNALS_TICKETING_ENABLED=false
OPS_SIGNALS_TICKETING_ACTIVE_PROVIDER=jira
# The worker runs only while ticketing is enabled; false stops it even then
OPS_SIGNALS_TICKETING_WORKER_ENABLED=true
OPS_SIGNALS_TICKETING_WORKER_POLL_INTERVAL_SECONDS=5
OPS_SIGNALS_TICKETING_AUTOMATIC_ON_CASE_CREATION=false

# Jira Cloud connection settings
OPS_SIGNALS_JIRA_BASE_URL=https://your-domain.atlassian.net
OPS_SIGNALS_JIRA_EMAIL=your-service-account@example.com
OPS_SIGNALS_JIRA_API_TOKEN=your-jira-api-token
OPS_SIGNALS_JIRA_PROJECT_KEY=OPS
OPS_SIGNALS_JIRA_ISSUE_TYPE=Task
OPS_SIGNALS_JIRA_TIMEOUT_SECONDS=10.0

# Secret for verifying incoming Jira webhook HMAC-SHA256 signatures.
# Required for the webhook: without it every webhook is refused (Sync now still works).
# OPS_SIGNALS_JIRA_WEBHOOK_SECRET=your-webhook-hmac-secret

# --- Metric usage: which metrics dashboards and alerts watch (backend/app/config.py: MetricUsageConfig) ---
# Read-only Grafana access: Administration -> Service accounts -> add one with the Viewer role.
# Setting the URL turns the 6-hourly check on; without it only Prometheus alert/recording rules count.
# OPS_SIGNALS_GRAFANA_URL=http://localhost:3000
# OPS_SIGNALS_GRAFANA_TOKEN=glsa_your-service-account-token
# Local Grafana without a token: basic auth instead.
# OPS_SIGNALS_GRAFANA_USERNAME=admin
# OPS_SIGNALS_GRAFANA_PASSWORD=admin
# Dashboards in these folders don't count as watching a metric (comma-separated, * wildcards).
# OPS_SIGNALS_METRIC_USAGE_EXCLUDE_FOLDERS=Scratch,Test*
# Metric names left out of the report (comma-separated, * wildcards).
# OPS_SIGNALS_METRIC_USAGE_IGNORE_METRICS=go_*,prometheus_*
# OPS_SIGNALS_METRIC_USAGE_INTERVAL_HOURS=6
# What 1,000 active series cost you per month, to show unused metrics as money on the Metric Usage
# page. There is no built-in price: unset, the page shows series counts instead.
# OPS_SIGNALS_METRIC_USAGE_COST_PER_1K_SERIES=
# OPS_SIGNALS_METRIC_USAGE_CURRENCY=USD

# --- Slack notifications (backend/app/config.py: SlackConfig) ---
# Off by default. See docs in the "Integrations" section of README.md.
OPS_SIGNALS_SLACK_ENABLED=false
OPS_SIGNALS_SLACK_WEBHOOK_URL=
# Findings below this importance_score (0-1) are not posted. Default: 0.7
OPS_SIGNALS_SLACK_MIN_IMPORTANCE=0.7
# HTTP timeout for the webhook POST, in seconds. Default: 10
OPS_SIGNALS_SLACK_TIMEOUT_SECONDS=10

# --- Alert enrichment (backend/app/config.py: AlertEnrichmentConfig) ---
# Alertmanager sends alerts to Ops Signals, which adds "what happened / what changed / seen before"
# and posts one Slack message per alert. See docs/design/alert-enrichment-plan.md.
# Off by default. With it on, scripts/run_all.sh also starts a local Alertmanager + demo alert rules
# (docker-compose.alerting.yml); fire test alerts with ./scripts/send_test_alert.py.
OPS_SIGNALS_ALERT_ENRICHMENT_ENABLED=false
# Where enriched alerts are posted. Empty = use OPS_SIGNALS_SLACK_WEBHOOK_URL above.
OPS_SIGNALS_ALERT_SLACK_WEBHOOK_URL=
# slack = post to Slack, none = enrich and store every alert but never post. Default: slack
OPS_SIGNALS_ALERT_NOTIFY=slack
# Only post these severities (comma-separated, e.g. critical,warning). Empty = all severities.
OPS_SIGNALS_ALERT_NOTIFY_SEVERITIES=
# Post a short "✅ Resolved" follow-up when Alertmanager resolves an alert. Default: true
OPS_SIGNALS_ALERT_NOTIFY_ON_RESOLVE=true
# Where people open the web UI, for "Open findings" / "Create a case" links in alert messages and
# Jira tickets. Empty = no links (and a startup warning); run_all.sh sets its frontend URL.
OPS_SIGNALS_UI_BASE_URL=
# Optional shared secrets. When set, requests must send "Authorization: Bearer <token>".
# Receiver token: add the same value under http_config.authorization in alertmanager.yml.
OPS_SIGNALS_ALERT_RECEIVER_TOKEN=
# Alert labels that name the service, first match wins. Default: service,job,app,app_kubernetes_io_name
OPS_SIGNALS_ALERT_SERVICE_LABELS=
# How much history to analyze before the alert (e.g. 6h, 24h). Default: 6h
OPS_SIGNALS_ALERT_LOOKBACK=
# Your Prometheus scrape interval; the query step never goes below it. Default: 30s
OPS_SIGNALS_ALERT_SCRAPE_INTERVAL=
# Smallest query step for alert analysis. Lower it only with a faster scrape (e.g. the live demo's 5s). Default: 30s
OPS_SIGNALS_ALERT_MIN_STEP=
# Analyzers skipped for alert-triggered runs (comma-separated; "none" = skip nothing). Default: prophet
OPS_SIGNALS_ALERT_EXCLUDED_ANALYZERS=
# How far before the alert a step change still counts as its start ("window" = anywhere in the
# analysed range, or e.g. 2h). See docs/alert-enrichment.md "How changes are timed". Default: window
OPS_SIGNALS_ALERT_STEP_LOOKBACK=
# How far before the alert a spike still counts as its start; older spikes are treated as over. Default: 1h
OPS_SIGNALS_ALERT_SPIKE_LOOKBACK=
# Change events listed from this long before to this long after the start time. Defaults: 30m, 5m
OPS_SIGNALS_ALERT_CHANGE_WINDOW_BEFORE=
OPS_SIGNALS_ALERT_CHANGE_WINDOW_AFTER=
# Skip change events whose env differs from the alert's env/environment label. Default: true
OPS_SIGNALS_ALERT_MATCH_ENV=

# --- Deploy and change events (inbound: your CI calls Ops Signals) ---
# Nothing to switch on: Ops Signals always accepts deploy, config, feature-flag and other change
# events at POST /api/events, and alerts show which came just before the problem. There is no URL
# to set here - copy Ops Signals' URL and a ready-made curl step for your CI pipeline from
# Integrations -> "Send deploy events" in the UI (docs/alert-enrichment.md, "What changed").
# Optional shared secret: when set, callers must send "Authorization: Bearer <token>".
OPS_SIGNALS_EVENTS_TOKEN=
# When CI names a service differently from the metrics' service label, list the names that mean the
# same service: groups separated by ";", names by ",". Example: cart,cart-service;checkout,checkout-api
OPS_SIGNALS_SERVICE_ALIASES=
# Findings link new pods to a deploy when the pods first reported within this long after it. Default: 15m
OPS_SIGNALS_DEPLOY_ROLLOUT_WINDOW=

# --- Finding drill-down (backend/app/config.py: DrillDownConfig) ---
# After an autonomous Prometheus run finds something, re-query the metric per pod and record which
# pods the change came from ("91% from pod checkout-x2"). See docs/finding-drilldown.md.
# Off by default.
OPS_SIGNALS_DRILLDOWN_ENABLED=false
# Labels to split by, tried in order. Default: pod,pod_name,kubernetes_pod_name,instance,host
OPS_SIGNALS_DRILLDOWN_LABELS=
# Most findings per job to drill into, most important first. Default: 3
OPS_SIGNALS_DRILLDOWN_MAX_FINDINGS=

# --- Deploys found in Prometheus (backend/app/config.py: DeployDiscoveryConfig) ---
# A new version on a *_build_info metric, or a new kube-state-metrics ReplicaSet, is stored as a
# deploy, so findings say what changed without CI. See docs/deploy-discovery.md. On by default.
OPS_SIGNALS_DEPLOY_DISCOVERY_ENABLED=
# How often to look, in minutes. Default: 5
OPS_SIGNALS_DEPLOY_DISCOVERY_INTERVAL_MINUTES=
# How far back each look goes, in hours. Default: 6
OPS_SIGNALS_DEPLOY_DISCOVERY_LOOKBACK_HOURS=
# Labels that hold the version, tried in order. Default: version,app_version,service_version
OPS_SIGNALS_DEPLOY_DISCOVERY_VERSION_LABELS=
# Also use kube-state-metrics ReplicaSets. Default: true
OPS_SIGNALS_DEPLOY_DISCOVERY_KUBE_REPLICASETS=

# --- Stored metric points (backend/app/services/point_retention.py) ---
# Each run saves the points it analyzed, for the chart on a finding. Points older than this many
# days are deleted about once an hour; findings are kept, and points behind a finding that has a
# case are kept at any age. Keep it longer than your longest analysis window. 0 keeps every point.
# Default: 30
OPS_SIGNALS_POINT_RETENTION_DAYS=

# --- Findings as metrics on GET /api/metrics (backend/app/config.py: FindingMetricsConfig) ---
# ops_signals_active_findings for Prometheus alert rules and dashboards. See docs/finding-metrics.md.
# On by default.
OPS_SIGNALS_FINDING_METRICS_ENABLED=
# Findings created this many hours ago or less count. Default: 24
OPS_SIGNALS_FINDING_METRICS_WINDOW_HOURS=
# Most series emitted. Default: 500
OPS_SIGNALS_FINDING_METRICS_MAX_SERIES=
# Scrapes this many seconds apart or less reuse the last count. Default: 30
OPS_SIGNALS_FINDING_METRICS_CACHE_SECONDS=
