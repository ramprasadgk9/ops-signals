# Copy this file to .env and fill in real values. .env is gitignored and loaded
# automatically by scripts/run_all.sh if present - no need to export these by hand.

# --- Slack notifications (backend/app/config.py: SlackConfig) ---
# Off by default. See docs in the "Integrations" section of README.md.
OPS_SIGNALS_SLACK_ENABLED=false
OPS_SIGNALS_SLACK_WEBHOOK_URL=
# Findings below this importance_score (0-1) are not posted. Default: 0.7
OPS_SIGNALS_SLACK_MIN_IMPORTANCE=0.7
# HTTP timeout for the webhook POST, in seconds. Default: 10
OPS_SIGNALS_SLACK_TIMEOUT_SECONDS=10

# --- Alert enrichment (backend/app/config.py: AlertEnrichmentConfig) ---
# Alertmanager sends alerts to Ops Signals, which adds "what happened / what changed / seen before"
# and posts one Slack message per alert. See docs/design/alert-enrichment-plan.md.
# Off by default. With it on, scripts/run_all.sh also starts a local Alertmanager + demo alert rules
# (docker-compose.alerting.yml); fire test alerts with ./scripts/send_test_alert.py.
OPS_SIGNALS_ALERT_ENRICHMENT_ENABLED=false
# Where enriched alerts are posted. Empty = use OPS_SIGNALS_SLACK_WEBHOOK_URL above.
OPS_SIGNALS_ALERT_SLACK_WEBHOOK_URL=
# slack = post to Slack, none = enrich and store every alert but never post. Default: slack
OPS_SIGNALS_ALERT_NOTIFY=slack
# Only post these severities (comma-separated, e.g. critical,warning). Empty = all severities.
OPS_SIGNALS_ALERT_NOTIFY_SEVERITIES=
# Post a short "✅ Resolved" follow-up when Alertmanager resolves an alert. Default: true
OPS_SIGNALS_ALERT_NOTIFY_ON_RESOLVE=true
# Base URL for "Open findings" / "Create a case" links in messages. Empty = run_all.sh's frontend URL.
OPS_SIGNALS_UI_BASE_URL=
# Optional shared secrets. When set, requests must send "Authorization: Bearer <token>".
# Receiver token: add the same value under http_config.authorization in alertmanager.yml.
OPS_SIGNALS_ALERT_RECEIVER_TOKEN=
# Events token: for POST /api/events (deploy/change events from CI).
OPS_SIGNALS_EVENTS_TOKEN=
# Alert labels that name the service, first match wins. Default: service,job,app,app_kubernetes_io_name
OPS_SIGNALS_ALERT_SERVICE_LABELS=
# How much history to analyze before the alert (e.g. 6h, 24h). Default: 6h
OPS_SIGNALS_ALERT_LOOKBACK=
# Your Prometheus scrape interval; the query step never goes below it. Default: 30s
OPS_SIGNALS_ALERT_SCRAPE_INTERVAL=
# Analyzers skipped for alert-triggered runs (comma-separated; "none" = skip nothing). Default: prophet
OPS_SIGNALS_ALERT_EXCLUDED_ANALYZERS=

# --- Finding drill-down (backend/app/config.py: DrillDownConfig) ---
# After an autonomous Prometheus run finds something, re-query the metric per pod and record which
# pods the change came from ("91% from pod checkout-x2"). See docs/finding-drilldown.md.
# Off by default.
OPS_SIGNALS_DRILLDOWN_ENABLED=false
# Labels to split by, tried in order. Default: pod,instance
OPS_SIGNALS_DRILLDOWN_LABELS=
# Most findings per job to drill into, most important first. Default: 3
OPS_SIGNALS_DRILLDOWN_MAX_FINDINGS=
