{
  "name": "ops-signals-frontend",
  "private": true,
  "version": "1.0.40",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config vite.admin.config.ts --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:admin": "tsc -b && vite build --config vite.admin.config.ts",
    "build:plugin": "npm run build",
    "build:grafana": "webpack -c ./webpack.config.ts --env production",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:web": "vitest run src/test/scenarios/web-ui",
    "test:plugin": "vitest run src/test/scenarios/plugin-ui",
    "test:scenarios": "npm run test:web && npm run test:plugin",
    "test:integration:web": "NODE_PATH=./node_modules playwright test --project=web-ui",
    "test:integration:plugin": "NODE_PATH=./node_modules playwright test --project=plugin",
    "test:integration": "NODE_PATH=./node_modules playwright test",
    "dev:grafana": "webpack -w -c ./webpack.config.ts --env development"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@grafana/data": "^13.3.1",
    "@grafana/runtime": "^13.3.1",
    "@grafana/ui": "^13.3.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tanstack/react-query": "^5.108.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@swc/core": "^1.16.22",
    "@swc/helpers": "^0.5.24",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "diagnostics-webpack-plugin": "^1.1.4",
    "fork-ts-checker-webpack-plugin": "^9.2.0",
    "imports-loader": "^5.0.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^31.0.1",
    "pg": "^8.23.1",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-merge": "^6.0.1",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  }
}
